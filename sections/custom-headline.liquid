<div class=" tw-relative tw-text-center  tw-my-20">
  <h3 class=" tw-text-4xl md:tw-text-[53px]  tw-mt-8 tw-pt-8 tw-mb-2 ">{{ section.settings.headlineA }}<span class="" style="color: {{ section.settings.headline2_color }}">
      {{ section.settings.headlineB }}</span>
  </h3>
  <span class="tw-text-3xl tw-w-full  md:tw-leading-normal sm:tw-text-4xl lg:tw-text-5xl tw-block    tw-text-black  tw-font-valueSansProRegular md:tw-w-9/12   tw-mx-auto  tw-px-5 custom-headling-subtitle ">{{ section.settings.subtitle }}</span>
</div>

{% schema %}
  {
    "name": "Custom Headline",
    "tag": "section",
    "class": "custom-headline",
    "settings": [
      {
        "type": "text",
        "label": "Headline - Part 1",
        "id": "headlineA",
        "default": "Welcome to",
        "placeholder": "Welcome to"
      }, {
        "type": "text",
        "label": "Headline - Part 2",
        "id": "headlineB",
        "default": "Bestvite",
        "placeholder": "Bestvite"
      }, {
        "type": "color",
        "label": "Headline - Part 2 - Color",
        "id": "headline2_color",
        "default": "#80C9C4"
      }, {
        "type": "text",
        "label": "Subtitle",
        "id": "subtitle",
        "default": "where your health is our priority, and affordability is a promise.",
        "placeholder": "where your health is our priority, and affordability is a promise."
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Custom Headline"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

