          "settings": {
            "title": "What is <strong>GMP</strong> certification?",
            "text": "<p>Good Manufacturing Practices (GMP) are a system of processes, procedures, and documentation designed to exert control over product manufacturing, ensuring the quality and safety of the product.</p>",
            "link_label": "Learn more",
            "link": "shopify://pages/nsf"
          }
        },
        "column_98RmwA": {
